{
  "name": "obsidian-workflow-hub",
  "version": "1.0.0",
  "description": "Obsidian plugin combining task management with version management",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "deploy": "npm run build && for dir in $(find ~ -maxdepth 6 -path \"*/.obsidian/plugins/obsidian-workflow-hub\" -type d 2>/dev/null); do cp main.js \"$dir/main.js\" && cp manifest.json \"$dir/manifest.json\" && echo \"deployed to $dir\"; done",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/ --ext .ts",
    "lint:fix": "eslint src/ tests/ --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "migrate": "ts-node scripts/migrate.ts",
    "test:migrate": "node scripts/test-comprehensive.js"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "task-management",
    "version-management",
    "project-management"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^16.11.6",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.17.3",
    "eslint": "^8.57.1",
    "jsdom": "^29.1.1",
    "obsidian": "latest",
    "prettier": "^3.8.3",
    "tslib": "2.4.0",
    "typescript": "4.7.4",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "js-yaml": "^5.2.2",
    "xlsx": "^0.18.5"
  }
}
